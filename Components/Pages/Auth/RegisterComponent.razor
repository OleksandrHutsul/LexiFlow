@page "/register"

<MudContainer MaxWidth="MaxWidth.Medium" Class="screen auth-screen">
    <section class="auth-card reveal">
        <div class="auth-copy">
            <span class="eyebrow">Create account</span>
            <h1>Start building words that stick.</h1>
            <p>Your account is the foundation for sync, spaced repetition, achievements, and future AI features.</p>
        </div>

        <MudForm Class="auth-form">
            <MudTextField @bind-Value="_model.UserName"
                          Label="Username"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Rounded.Person"
                          Immediate="true" />

            <MudTextField @bind-Value="_model.Email"
                          Label="Email"
                          InputType="InputType.Email"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Rounded.Mail"
                          Immediate="true" />

            <MudTextField @bind-Value="_model.Password"
                          Label="Password"
                          InputType="@PasswordInputType"
                          Adornment="Adornment.End"
                          AdornmentIcon="@PasswordIcon"
                          OnAdornmentClick="TogglePassword"
                          Immediate="true" />

            <div class="password-meter">
                <span style="width:@PasswordStrengthPercent%"></span>
            </div>

            <small class="muted">@PasswordStrengthLabel</small>

            <MudTextField @bind-Value="_model.ConfirmPassword"
                          Label="Confirm password"
                          InputType="@PasswordInputType"
                          Immediate="true" />

            @if (_errors.Count > 0)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                    @string.Join(" ", _errors)
                </MudAlert>
            }

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       FullWidth="true"
                       Disabled="_isBusy"
                       OnClick="SubmitAsync">
                @if (_isBusy)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                    <span>Creating account...</span>
                }
                else
                {
                    <span>Register</span>
                }
            </MudButton>

            <p class="auth-switch">
                Already have an account?
                <MudLink Href="/login">Login</MudLink>
            </p>
        </MudForm>
    </section>
</MudContainer>
