@page "/learning"
@using LexiFlow.Components.Shared.UI
@attribute [Authorize]

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="screen">
    <section class="page-header reveal">
        <span class="eyebrow">Learning</span>
        <h1>Collections for every context.</h1>
        <p>Organize words by context and choose one default collection for one-click saving.</p>

        <div>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Rounded.CreateNewFolder"
                       OnClick="CreateCollectionAsync">
                New collection
            </MudButton>
        </div>
    </section>

    @if (_loading)
    {
        <div class="skeleton-list">
            <span></span>
            <span></span>
            <span></span>
        </div>
    }
    else if (_collections.Count == 0)
    {
        <EmptyStateComponent Title="No learning collections"
                    Text="Create a collection to start saving vocabulary." />
    }
    else
    {
        <div class="collection-grid">
            @foreach (var collection in _collections)
            {
                <section class="collection-card reveal collection-card-link"
                         style="--accent:@collection.Accent"
                         @onclick="() => OpenCollection(collection.Id)">
                    <div class="section-heading">
                        <div>
                            <span class="eyebrow">@collection.Words.Count words</span>

                            <h2>
                                @collection.Name

                                @if (collection.IsDefault)
                                {
                                    <span class="default-badge">
                                        <MudIcon Icon="@Icons.Material.Rounded.Star" Size="Size.Small" />
                                        Default
                                    </span>
                                }
                            </h2>
                        </div>

                        <div class="collection-actions" @onclick:stopPropagation="true">
                            @if (!collection.IsDefault)
                            {
                                <MudIconButton Icon="@Icons.Material.Rounded.StarOutline"
                                               title="Make default"
                                               aria-label="@($"Make {collection.Name} the default collection")"
                                               OnClick="() => SetDefaultAsync(collection.Id)" />
                            }

                            <MudIconButton Icon="@Icons.Material.Rounded.Edit"
                                           title="Edit collection"
                                           aria-label="@($"Edit {collection.Name}")"
                                           OnClick="() => EditCollectionAsync(collection)" />

                            <MudIconButton Icon="@Icons.Material.Rounded.DeleteOutline"
                                           Color="Color.Error"
                                           title="Delete collection"
                                           aria-label="@($"Delete {collection.Name}")"
                                           Disabled="@_deletingCollectionIds.Contains(collection.Id)"
                                           OnClick="() => DeleteCollectionAsync(collection)" />
                        </div>
                    </div>

                    @foreach (var word in collection.Words.Take(6))
                    {
                        <div class="learning-row">
                            <span>@word.Word</span>
                            <MudChip T="string" Size="Size.Small">@StateLabel(word.State)</MudChip>
                        </div>
                    }

                    @if (collection.Words.Count == 0)
                    {
                        <p class="muted">Add words from Dictionary to fill this collection.</p>
                    }
                    else
                    {
                        <div class="collection-card-footer" @onclick:stopPropagation="true">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Rounded.Style"
                                       Href="@($"/flashcards?collectionId={collection.Id}")">
                                Study
                            </MudButton>

                            <MudButton Variant="Variant.Text"
                                       Size="Size.Small"
                                       Href="@($"/learning/{collection.Id}")">
                                View all
                            </MudButton>
                        </div>
                    }
                </section>
            }
        </div>
    }
</MudContainer>
